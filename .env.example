# Sempre use /api — nunca a URL absoluta do Render no browser.
# Dev: Vite faz proxy. Prod (Vercel): vercel.json reescreve /api → staging.
# URL cross-origin vira cookie third-party e o login "funciona" mas /auth/me dá 401.
VITE_API_URL=/api

# Origem do Nest no proxy local (sem /api no final).
# Padrão da equipe: API hospedada (não precisa clonar nem subir o Backend).
API_PROXY_TARGET=http://api-staging-zoneconnection.179.198.111.97.sslip.io
# Só quem desenvolve o Nest nesta máquina:
# API_PROXY_TARGET=http://127.0.0.1:3333

# URL pública do site (canonical, Open Graph, JSON-LD). Sem barra no final.
# Se mudar o domínio, atualize também public/robots.txt e public/sitemap.xml.
VITE_SITE_URL=https://www.zoneconnection.com.br

# Google Analytics 4 (Measurement ID). Padrão: G-9HHXQ8CC3V
VITE_GA_MEASUREMENT_ID=G-9HHXQ8CC3V
